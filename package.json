{
  "name": "card-world-cup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && tsc && vite build",
    "build:poki": "cross-env VITE_AD_SDK=poki vite build",
    "build:crazygames": "cross-env VITE_AD_SDK=crazygames vite build",
    "build:none": "cross-env VITE_AD_SDK=none vite build",
    "lint": "eslint .",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pixi/sound": "6.0.1",
    "motion": "12.4.7",
    "pixi.js": "8.8.1"
  },
  "devDependencies": {
    "@assetpack/core": "1.4.0",
    "@eslint/js": "9.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-prettier": "5.2.6",
    "prettier": "3.5.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "vite": "6.2.0",
    "vitest": "^4.1.7"
  }
}
